# ─────────────────────────────────────────────────────────────────────────────
# BioT Sensor Assistant — environment variables
#
# This file is in .gitignore. NEVER commit a real API key.
# If you want to share the variable layout with someone, use .env.example.
# ─────────────────────────────────────────────────────────────────────────────

# Which LLM provider to use (required)
# Options: anthropic | openai | deepseek | gemini
LLM_PROVIDER=anthropic

# API key for the selected provider (required)
#   Anthropic → https://console.anthropic.com        sk-ant-...
#   OpenAI    → https://platform.openai.com          sk-...
#   DeepSeek  → https://platform.deepseek.com        sk-...
#   Gemini    → https://aistudio.google.com/apikey   AI...
LLM_API_KEY=REPLACE_WITH_YOUR_KEY

# Model to use (optional — a sensible default is chosen per provider if omitted)
LLM_MODEL=claude-sonnet-4-6

# Absolute path to the SQLite sensor database (optional)
# Leave empty to use the default: data/sensor_database.db
SQLITE_DB_PATH=C:\Users\Arun\Documents\School\BioT_Speech_IoT_LLM_App\data\sensor_database.db

# Filesystem roots the agent is allowed to read from (optional)
MCP_FS_ROOTS=C:\Users\Arun\Documents\School\BioT_Speech_IoT_LLM_App\sample_files

# FastAPI server bind settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# MCP server (subprocess of the FastAPI server)
MCP_SERVER_PORT=8002

# Mosquitto broker — the same one the Android app and ESP8266 use
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
