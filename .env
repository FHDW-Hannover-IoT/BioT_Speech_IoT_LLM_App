# ─────────────────────────────────────────────────────────────────────────────
# BioT Sensor Assistant — environment variable template
#
# Copy this file to .env and fill in your values.
# .env is in .gitignore and must NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Which LLM provider to use (required)
# Options: anthropic | openai | deepseek | gemini
LLM_PROVIDER=anthropic

# API key for the selected provider (required)
#   Anthropic → https://console.anthropic.com        key format: sk-ant-...
#   OpenAI    → https://platform.openai.com          key format: sk-...
#   DeepSeek  → https://platform.deepseek.com        key format: sk-...
#   Gemini    → https://aistudio.google.com/apikey   key format: AI...
LLM_API_KEY=

# Model to use (optional — a sensible default is chosen per provider if omitted)
#   Anthropic default : claude-sonnet-4-6
#   OpenAI default    : gpt-4.1
#   DeepSeek default  : deepseek-chat     (deepseek-reasoner for chain-of-thought)
#   Gemini default    : gemini-2.0-flash  (gemini-1.5-pro for longer context)
LLM_MODEL=claude-sonnet-4-6

# Absolute path to the SQLite sensor database (optional)
# Leave empty to use the default: data/sensor_database.db
SQLITE_DB_PATH=

# Filesystem roots the agent is allowed to read from (optional)
# Used by the filesystem MCP server. Separate multiple paths with a comma or semicolon.
# Leave empty to use the default: the sample_files/ folder inside this project.
# Example: C:\Users\Arun\Documents\School\BioT_Speech_IoT_LLM_App\sample_files
MCP_FS_ROOTS=

# Server bind settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
